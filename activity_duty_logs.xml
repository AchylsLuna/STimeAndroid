<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    tools:context=".DutyLogs">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duty past logs"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"/>

    <TextView
        android:id="@+id/dateRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jan 1, 2024 - Jan 15, 2024"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/filterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter by date"
        android:backgroundTint="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/dateRange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TableLayout
            android:id="@+id/tableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:background="@android:color/white"
            android:layout_marginTop="10dp">

            <TableRow android:background="@android:color/white">
                <TextView
                    android:text="@string/date"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:background="@android:color/black"
                    android:textColor="@android:color/white"/>
                <TextView
                    android:text="@string/timein"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:background="@android:color/black"
                    android:textColor="@android:color/white"/>
                <TextView
                    android:text="@string/timeout"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:background="@android:color/black"
                    android:textColor="@android:color/white"/>
                <TextView
                    android:text="@string/totalhours"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:background="@android:color/black"
                    android:textColor="@android:color/white"/>
            </TableRow>

            <!-- 13 Empty Rows for User Input -->
            <TableRow>
                <EditText
                    android:minHeight="48dp"
                    android:autofillHints="date"
                    android:hint="@string/date"
                    android:textColorHint="@color/white"
                    android:inputType="date"
                    android:padding="8dp" />

                <EditText
                    android:autofillHints="timein"
                    android:hint="@string/timein"
                    android:inputType="time"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:textColorHint="@color/white" />

                <EditText
                    android:autofillHints="timeout"
                    android:hint="@string/timeout"
                    android:inputType="time"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:textColorHint="@color/white" />

                <TextView
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="" />
            </TableRow>

        </TableLayout>
    </ScrollView>

    <TextView
        android:id="@+id/totalHoursText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Hours: "
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.036"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.907" />
</androidx.constraintlayout.widget.ConstraintLayout>