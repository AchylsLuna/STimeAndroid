<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".logs"
    android:layout_gravity="center"
    android:background="@color/white">


    <LinearLayout
        android:id="@+id/attendanceLayout"
        android:layout_width="367dp"
        android:layout_height="113dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/container"
        android:elevation="19dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="44dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedules"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="348dp"
            android:layout_height="83dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/container"
            android:elevation="19dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/timein"
                android:textSize="15sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:gravity="center"
                android:text="@string/time_outt"
                android:textSize="15sp" />


        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sublog"
        android:layout_width="351dp"
        android:layout_height="361dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/container"
        android:elevation="19dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <!-- Date Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/dates"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <!-- Date Input -->
        <EditText
            android:id="@+id/dateInput"
            android:layout_width="325dp"
            android:layout_height="57dp"
            android:background="@android:color/white"
            android:clickable="true"
            android:focusable="false"
            android:hint="Enter Date"
            android:inputType="date"
            android:padding="8dp"
            android:textSize="14sp" />


        <!-- Time In Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/timee"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <!-- Time In Input -->
        <EditText
            android:id="@+id/timeIn"
            android:layout_width="322dp"
            android:layout_height="57dp"
            android:background="@android:color/white"
            android:clickable="true"
            android:focusable="false"
            android:hint="Enter Time In"
            android:inputType="time"
            android:padding="8dp"
            android:textSize="14sp" />


        <!-- Time Out Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/outt"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <!-- Time Out Input -->
        <EditText
            android:id="@+id/timeOut"
            android:layout_width="335dp"
            android:layout_height="57dp"
            android:background="@android:color/white"
            android:clickable="true"
            android:focusable="true"
            android:hint="@string/enter_time_out"
            android:inputType="time"
            android:padding="8dp"
            android:textSize="14sp" />

        <!-- Spacer to push the button to the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/LogsSubmit"
            android:layout_width="245dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="@color/green"
            android:text="@string/submit" />

    </LinearLayout>

    <Button
        android:id="@+id/pstLogs"
        android:layout_width="195dp"
        android:layout_height="64dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/green"
        android:text="@string/view_past_logs"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="194dp" />

    <TextView
        android:id="@+id/dutyTitle"
        android:layout_width="174dp"
        android:layout_height="36dp"
        android:text="@string/add_duty_logs"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.109"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="207dp" />

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="106dp"
        tools:layout_editor_absoluteX="-2dp"
        tools:layout_editor_absoluteY="622dp"
        tools:ignore="MissingConstraints">


        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="409dp"
            android:layout_height="92dp"
            android:background="@color/white"
            app:itemIconTint="@color/black"
            app:itemTextColor="@color/black"
            app:menu="@menu/bottom_nav_menu">

        </com.google.android.material.bottomnavigation.BottomNavigationView>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>